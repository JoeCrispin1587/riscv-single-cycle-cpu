
// controller.v - controller for RISC-V CPU

module controller (
    input [6:0]  op,
    input [2:0]  funct3,
    input        funct7b5,
    input        Zero,lt ltu,
    output       [1:0] ResultSrc,
    output       MemWrite,
    output       PCSrc, ALUSrc,
    output       RegWrite, Jump,Jalr,
    output [1:0] ImmSrc,
    output [3:0] ALUControl //changed from 2 to 3
);

wire [1:0] ALUOp;
wire       Branch;
reg        TakeBranch;  //internal wire for branch evaluvation

main_decoder    md (op, ResultSrc, MemWrite, Branch,
                    ALUSrc, RegWrite, Jump,Jalr, ImmSrc, ALUOp);

alu_decoder     ad (op[5], funct3, funct7b5, ALUOp, ALUControl);

//branch condition logic
always @(*) begin
    case (funct3)
        3'b000: TakeBranch = Zero ;  // beq a=b
        3'b001: TakeBranch = ~ Zero; // bne a!=b
        3'b100: TakeBranch = lt;     // blt a<b(signed)
        3'b101: TakeBranch = ~lt;    // bge a>=b (signed)
        3'b110: TakeBranch = ltu;    // bltu a<b (unsigned)
        3'b111: TakeBranch = ~ltu;   // bgeu a>=b (unsigned)
        default:TakeBranch = 1'b0;
    endcase
end 

// for jump and branch
assign PCSrc = (Branch & TakeBranch) | Jump;

endmodule

